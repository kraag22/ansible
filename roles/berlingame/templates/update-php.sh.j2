#!/bin/sh
# Nightly rebuild of the berlingame PHP image with a freshly pulled base image.
# Restarts the service only when the rebuilt image differs from the current one.
set -eu

cd {{ compose_path | quote }}

image=$(docker compose config --images server)
old_id=$(docker image inspect --format '{% raw %}{{.Id}}{% endraw %}' "$image" 2>/dev/null || true)

docker compose build --pull --quiet server

new_id=$(docker image inspect --format '{% raw %}{{.Id}}{% endraw %}' "$image")

if [ "$old_id" != "$new_id" ]; then
    echo "$(date -Is) PHP image changed ($old_id -> $new_id), restarting berlingame"
    systemctl restart berlingame
    docker image prune -f
else
    echo "$(date -Is) PHP image unchanged"
fi
