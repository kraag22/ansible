#!/bin/sh
# Rebuild PHP and reconcile the running container, even after a missed update.
set -eu

cd {{ compose_path | quote }}

docker compose build --pull --quiet server
docker compose up -d --no-deps server

image=$(docker compose config --images server)
container=$(docker compose ps -q server)
test -n "$container"
expected=$(docker image inspect --format '{% raw %}{{.Id}}{% endraw %}' "$image")
actual=$(docker inspect --format '{% raw %}{{.Image}}{% endraw %}' "$container")
if [ "$actual" != "$expected" ]; then
    echo "PHP image update failed: running $actual, expected $expected" >&2
    exit 1
fi

echo "$(date -Is) PHP container uses $actual"
docker image prune -f
