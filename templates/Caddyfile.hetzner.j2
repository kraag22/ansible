drevenak-luka.cz, www.drevenak-luka.cz {
  reverse_proxy /* 127.0.0.1:3500
  encode gzip
  log {
    format console
    output file {{ caddy_log_dir }}/drevenak.log
  }
  tls {{ tls_email }}
}

serosvet.cz, www.serosvet.cz {
  reverse_proxy /* 127.0.0.1:{{ quests_service_port }}
  encode gzip
  log {
    format console
    output file {{ caddy_log_dir }}/quests.log
  }
  tls {{ tls_email }}
}

www.berlingame.cz, berlingame.cz {
  reverse_proxy /* 127.0.0.1:{{ berlingame_service_port }}
  encode gzip
  log {
    format console
    output file {{ caddy_log_dir }}/berlingame.log
  }
  tls {{ tls_email }}
}

www.gamarna.cz, gamarna.cz {
  tls {{ tls_email }}
  reverse_proxy /* 127.0.0.1:{{ graphs_service_port }}
  encode gzip
  log {
    format console
    output file {{ caddy_log_dir }}/gamarna.log
  }
}

www.kraag22.com, kraag22.com {
  tls {{ tls_email }}
  root * {{ blog_path }}
  file_server
  try_files {path}.html {path}
  encode gzip
  log {
    format console
    output file {{ caddy_log_dir }}/kraag22.log
  }
}

plausible.kraag22.com {
  reverse_proxy /* 127.0.0.1:5000
  encode gzip
  log {
    format console
    output file {{ caddy_log_dir }}/plausible.log
  }
  tls {{ tls_email }}
}
